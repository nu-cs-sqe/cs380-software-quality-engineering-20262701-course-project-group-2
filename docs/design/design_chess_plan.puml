@startuml

skinparam classAttributeIconSize 0

' PlantUML supports {static} and {abstract} member modifiers,
' but not a {final} member modifier. Java final fields are therefore
' shown without a special PlantUML modifier.

class Main {
    - Main()
    + {static} main(args: String[]): void
}

package controller {
    class BoardController {
        - {static} BOARD_SIZE: int
        - game: Game
        - selectedSquare: Location
        - highlightedSquares: Set<Location>
        + BoardController(game: Game)
        + getBoardSnapshot(): Piece[][]
        + getCurrentTurn(): PieceColor
        + getSelectedSquare(): Location
        + getHighlightedSquares(): Set<Location>
        + handleSquareClick(location: Location): void
        - isInsideBoard(location: Location): boolean
        - moveSelectedPieceTo(destination: Location): void
        - isOwnPiece(location: Location): boolean
        - select(location: Location): void
        - deselect(): void
    }
}

package domain {
    class Board {
        - {static} BOARD_SIZE: int
        - pieces: Piece[][]
        + Board()
        + getSnapshot(): Piece[][]
        + movePiece(from: Location, to: Location): void
        - initializeBoard(): void
        - initializePieces(color: PieceColor, pieceRow: int, pawnRow: int): void
    }

    class Game {
        - {static} BOARD_SIZE: int
        - board: Board
        - currentTurn: PieceColor
        + Game()
        ~ Game(board: Board)
        + getCurrentTurn(): PieceColor
        + getBoardSnapshot(): Piece[][]
        + movePiece(from: Location, to: Location): void
        + switchTurn(): void
        + getLegalMoves(from: Location): Set<Location>
        - {static} pieceAt(boardState: Piece[][], location: Location): Piece
        - {static} isPathAvailableForPiece(boardState: Piece[][], piece: Piece, from: Location, destination: Location): boolean
        - {static} isBlockedByFriendly(boardState: Piece[][], piece: Piece, destination: Location): boolean
        - {static} isPathClear(boardState: Piece[][], from: Location, to: Location): boolean
        - {static} getPawnCaptures(boardState: Piece[][], pawn: Piece, from: Location): Set<Location>
    }

    class Location {
        - {static} HASH_MULTIPLIER: int
        - column: int
        - row: int
        + Location(column: int, row: int)
        + getColumn(): int
        + getRow(): int
        + equals(other: Object): boolean
        + hashCode(): int
    }

    enum GameMode {
        CLASSIC
        KING_OF_THE_HILL
    }

    package piece {
        abstract class Piece {
            - {static} BOARD_SIZE: int
            - type: PieceType
            - color: PieceColor
            + Piece(type: PieceType, color: PieceColor)
            + getType(): PieceType
            + getColor(): PieceColor
            + {abstract} makeCopy(): Piece
            + {abstract} getValidMoves(from: Location): Set<Location>
            # getDirectionalMoves(from: Location, directions: int[][]): Set<Location>
            # isInsideBoard(column: int, row: int): boolean
            + toString(): String
        }

        class Pawn {
            + Pawn(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location): Set<Location>
        }

        class Knight {
            + Knight(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location): Set<Location>
        }

        class Bishop {
            + Bishop(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location): Set<Location>
        }

        class Rook {
            + Rook(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location): Set<Location>
        }

        class Queen {
            + Queen(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location): Set<Location>
        }

        class King {
            + King(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location): Set<Location>
        }

        enum PieceColor {
            BLACK
            WHITE
        }

        enum PieceType {
            PAWN
            ROOK
            KNIGHT
            BISHOP
            QUEEN
            KING
        }
    }
}

package view {
    class WelcomeView {
        - player1NameField: JTextField
        - player2NameField: JTextField
        + WelcomeView()
        - startGame(): void
        - validatePlayerNames(player1Name: String, player2Name: String): Optional<String>
    }

    class MainView {
        - player1Name: String
        - player2Name: String
        - boardController: BoardController
        + MainView(player1Name: String, player2Name: String)
    }

    class BoardView {
        - boardController: BoardController
        - selectedRow: int
        - selectedColumn: int
        + BoardView(boardController: BoardController)
        # paintComponent(graphics: Graphics): void
        - drawBoard(graphics: Graphics): void
        - drawPieces(graphics: Graphics): void
        - drawSelectedSquare(graphics: Graphics): void
    }

    class GameStatsView {
        - currentPlayerLabel: JLabel
        + GameStatsView(player1Name: String, player2Name: String, boardController: BoardController)
        + getCurrentPlayerText(): String
    }
}

Pawn --|> Piece
Knight --|> Piece
Bishop --|> Piece
Rook --|> Piece
Queen --|> Piece
King --|> Piece

Piece --> PieceType
Piece --> PieceColor
Piece ..> Location
Board *-- "0..64" Piece
Game *-- Board
Game --> PieceColor
Game ..> Location
Game ..> Piece
BoardController --> Game
BoardController --> "0..*" Location
BoardView --> BoardController
GameStatsView --> BoardController
MainView *-- BoardController
MainView ..> Game
MainView *-- BoardView
MainView *-- GameStatsView
WelcomeView ..> MainView
Main ..> WelcomeView

note right of GameMode
  Present in source but not connected
  to the current Game/UI flow.
end note

note right of Game
  movePiece(from, to) currently exists but throws
  UnsupportedOperationException.
end note

@enduml