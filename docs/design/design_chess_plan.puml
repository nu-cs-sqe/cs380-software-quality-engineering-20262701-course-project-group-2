@startuml

+class Main {
    + {static} main(args: String[]): void
}

package "controller" {

    +class BoardController {
        - {final} board: Board

        + BoardController()
        + handleSquareClick(location: Location): void
        + getBoardSnapshot(): Piece[][]
    }
}

package "domain" {

    +class Board {
        - {static} {final} BOARD_SIZE: int
        - {final} pieces: Piece[][]

        + Board()
        - initializeBoard(): void
        - initializePieces(color: PieceColor, pieceRow: int, pawnRow: int): void
        + getSnapshot(): Piece[][]
    }

    +class Game {
    }

    +enum GameMode {
        CLASSIC
        KING_OF_THE_HILL
    }

    +class Location {
        - {final} column: int
        - {final} row: int

        + Location(column: int, row: int)
        + getColumn(): int
        + getRow(): int
    }

    package "piece" {

        +abstract Piece {
            - {final} type: PieceType
            - {final} color: PieceColor

            + Piece(type: PieceType, color: PieceColor)
            + getType(): PieceType
            + getColor(): PieceColor
            + {abstract} makeCopy(): Piece
            + toString(): String
        }

        +class Pawn {
            + Pawn(color: PieceColor)
            + makeCopy(): Piece
        }

        +class Rook {
            + Rook(color: PieceColor)
            + makeCopy(): Piece
        }

        +class Knight {
            + Knight(color: PieceColor)
            + makeCopy(): Piece
        }

        +class Bishop {
            + Bishop(color: PieceColor)
            + makeCopy(): Piece
        }

        +class Queen {
            + Queen(color: PieceColor)
            + makeCopy(): Piece
        }

        +class King {
            + King(color: PieceColor)
            + makeCopy(): Piece
        }

        +enum PieceColor {
            BLACK
            WHITE
        }

        +enum PieceType {
            PAWN
            ROOK
            KNIGHT
            BISHOP
            QUEEN
            KING
        }
    }
}

package "view" {

    +class WelcomeView {
        - player1NameField: JTextField
        - player2NameField: JTextField

        + WelcomeView()
        - createWelcomeScreenUI(): void
        - startGame(): void
    }

    +class MainView {
        - {final} player1Name: String
        - {final} player2Name: String

        + MainView(player1Name: String, player2Name: String)
        - configureMainView(): void
        - addGameStatsView(): void
        - addBoardView(): void
    }

    +class BoardView {
        - {static} {final} BOARD_SIZE: int
        - {static} {final} TILE_SIZE: int
        - {static} {final} LIGHT_SQUARE_COLOR: Color
        - {static} {final} DARK_SQUARE_COLOR: Color
        - {static} {final} SELECTED_SQUARE_COLOR: Color
        - {final} whitePieceImages: Map<PieceType, Image>
        - {final} blackPieceImages: Map<PieceType, Image>
        - {final} boardController: BoardController
        - selectedRow: int
        - selectedColumn: int

        + BoardView(boardController: BoardController)
        # paintComponent(graphics: Graphics): void
        - drawBoard(graphics: Graphics): void
        - loadPieceImages(): void
        - loadPieceImage(type: PieceType, color: PieceColor, imagePath: String): void
        - drawPieces(graphics: Graphics): void
        - drawSelectedSquare(graphics: Graphics): void
    }

    +class GameStatsView {
        - {final} currentPlayerLabel: JLabel

        + GameStatsView(player1Name: String, player2Name: String)
    }
}


Pawn -u-|> Piece
Rook -u-|> Piece
Knight -u-|> Piece
Bishop -u-|> Piece
Queen -u-|> Piece
King -u-|> Piece

Piece --> PieceType
Piece --> PieceColor

Board --> Piece
Board ..> PieceColor
Board ..> Pawn
Board ..> Rook
Board ..> Knight
Board ..> Bishop
Board ..> Queen
Board ..> King

BoardController --> Board
BoardController ..> Location
BoardController ..> Piece

BoardView --> BoardController
BoardView --> PieceType
BoardView ..> PieceColor
BoardView ..> Piece
BoardView ..> Location

MainView ..> BoardController
MainView ..> BoardView
MainView ..> GameStatsView

WelcomeView ..> MainView

Main ..> WelcomeView

@enduml