@startuml

+class Main {
    + {static} main(args: String[]): void
}

package "controller" {

    +class BoardController {
        - {final} game: Game
        - selectedSquare: Location
        - highlightedSquares: Set<Location>

        + BoardController(game: Game)
        + handleSquareClick(location: Location): void
        + getSelectedSquare(): Location
        + getHighlightedSquares(): Set<Location>
        + getCurrentTurn(): PieceColor
        + getBoardSnapshot(): Piece[][]
        + getGameMode(): GameMode
        + getWinner(): PieceColor
    }
}

package "domain" {

    +class Board {
        - {static} {final} BOARD_SIZE: int
        - {final} pieces: Piece[][]

        + Board()
        - initializeBoard(): void
        - initializePieces(color: PieceColor, pieceRow: int, pawnRow: int): void

        + getSnapshot(): Piece[][]
        + getPieceAt(location: Location): Piece
        + getValidMovesByPiece(location: Location): Set<Location>
        + movePiece(from: Location, to: Location): void
        + findKing(color: PieceColor): Location
    }

    +class Game {
        - {final} board: Board
        - {final} gameMode: GameMode
        - currentTurn: PieceColor
        - winner: PieceColor

        - whiteKingSideCastlingAvailable: boolean
        - whiteQueenSideCastlingAvailable: boolean
        - blackKingSideCastlingAvailable: boolean
        - blackQueenSideCastlingAvailable: boolean

        + Game(gameMode: GameMode)

        + getCurrentTurn(): PieceColor
        + getBoardSnapshot(): Piece[][]
        + getGameMode(): GameMode
        + getLegalMoves(location: Location): Set<Location>
        + movePiece(from: Location, to: Location): void
        + switchTurn(): void
        + isInCheck(color: PieceColor): boolean
        + isCheckmate(color: PieceColor): boolean
        + getWinner(): PieceColor
    }

    +enum GameMode {
        CLASSIC
        KING_OF_THE_HILL
    }

    +class Location {
        - {final} column: int
        - {final} row: int

        + Location(column: int, row: int)
        + getColumn(): int
        + getRow(): int
        + equals(other: Object): boolean
        + hashCode(): int
    }

    package "piece" {

        +abstract Piece {
            - {final} type: PieceType
            - {final} color: PieceColor

            + Piece(type: PieceType, color: PieceColor)
            + getType(): PieceType
            + getColor(): PieceColor
            + {abstract} makeCopy(): Piece
            + {abstract} getValidMoves(from: Location, board: Piece[][]): Set<Location>
            + toString(): String
        }

        +class Pawn {
            + Pawn(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location, board: Piece[][]): Set<Location>
        }

        +class Rook {
            + Rook(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location, board: Piece[][]): Set<Location>
        }

        +class Knight {
            + Knight(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location, board: Piece[][]): Set<Location>
        }

        +class Bishop {
            + Bishop(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location, board: Piece[][]): Set<Location>
        }

        +class Queen {
            + Queen(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location, board: Piece[][]): Set<Location>
        }

        +class King {
            + King(color: PieceColor)
            + makeCopy(): Piece
            + getValidMoves(from: Location, board: Piece[][]): Set<Location>
        }

        +enum PieceColor {
            BLACK
            WHITE
        }

        +enum PieceType {
            PAWN
            ROOK
            KNIGHT
            BISHOP
            QUEEN
            KING
        }
    }
}

package "view" {

    +class WelcomeView {
        - player1NameField: JTextField
        - player2NameField: JTextField
        - gameModeSelector: JComboBox<GameMode>

        + WelcomeView()
        - createWelcomeScreenUI(): void
        - startGame(): void
    }

    +class MainView {
        - {final} player1Name: String
        - {final} player2Name: String
        - {final} boardController: BoardController

        + MainView(player1Name: String, player2Name: String, gameMode: GameMode)
        - configureMainView(): void
        - addGameStatsView(): void
        - addBoardView(): void
    }

    +class BoardView {
        - {static} {final} BOARD_SIZE: int
        - {static} {final} TILE_SIZE: int
        - {static} {final} LIGHT_SQUARE_COLOR: Color
        - {static} {final} DARK_SQUARE_COLOR: Color
        - {static} {final} SELECTED_SQUARE_COLOR: Color
        - {static} {final} HIGHLIGHTED_SQUARE_COLOR: Color

        - {final} whitePieceImages: Map<PieceType, Image>
        - {final} blackPieceImages: Map<PieceType, Image>
        - {final} boardController: BoardController

        + BoardView(boardController: BoardController)
        # paintComponent(graphics: Graphics): void

        - drawBoard(graphics: Graphics): void
        - loadPieceImages(): void
        - loadPieceImage(type: PieceType, color: PieceColor, imagePath: String): void
        - drawPieces(graphics: Graphics): void
        - drawSelectedSquare(graphics: Graphics): void
        - drawHighlightedSquares(graphics: Graphics): void
    }

    +class GameStatsView {
        - {final} player1Name: String
        - {final} player2Name: String
        - {final} boardController: BoardController
        - {final} currentPlayerLabel: JLabel
        - {final} winnerLabel: JLabel

        + GameStatsView(player1Name: String, player2Name: String, boardController: BoardController)
    }
}


